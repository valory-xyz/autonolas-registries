uts\":[{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"author\":\"Aleksandr Kuperman - <aleksandr.kuperman@valory.xyz>\",\"errors\":{\"IncorrectDataLength(uint256,uint256)\":[{\"details\":\"Provided incorrect data length.\",\"params\":{\"expected\":\"Expected minimum data length.\",\"provided\":\"Provided data length.\"}}],\"MultisigExecFailed(address)\":[{\"details\":\"Multisig transaction resulted in a failure.\",\"params\":{\"provided\":\"Provided multisig address.\"}}],\"UnauthorizedMultisig(address)\":[{\"details\":\"Multisig proxy bytecode is not whitelisted.\",\"params\":{\"multisig\":\"Address of a multisig proxy.\"}}],\"WrongNumOwners(uint256,uint256)\":[{\"details\":\"Provided incorrect number of owners.\",\"params\":{\"expected\":\"Expected number of owners.\",\"provided\":\"Provided number of owners.\"}}],\"WrongOwner(address)\":[{\"details\":\"Provided incorrect multisig owner.\",\"params\":{\"provided\":\"Provided owner address.\"}}],\"WrongThreshold(uint256,uint256)\":[{\"details\":\"Provided incorrect multisig threshold.\",\"params\":{\"expected\":\"Expected threshold.\",\"provided\":\"Provided threshold.\"}}],\"ZeroValue()\":[{\"details\":\"Zero value when it has to be different from zero.\"}]},\"kind\":\"dev\",\"methods\":{\"constructor\":{\"details\":\"GnosisSafeSameAddressMultisig constructor.\",\"params\":{\"_proxyHash\":\"Approved multisig proxy hash.\"}},\"create(address[],uint256,bytes)\":{\"details\":\"Updates and/or verifies the existent gnosis safe multisig for changed owners and threshold.\",\"params\":{\"data\":\"Packed data containing address of an existent gnosis safe multisig and a payload to call the multisig with.\",\"owners\":\"Set of updated multisig owners to verify against.\",\"threshold\":\"Updated number for multisig transaction confirmations.\"},\"returns\":{\"multisig\":\"Address of a multisig (proxy).\"}}},\"title\":\"Gnosis Safe Same Address - Smart contract for Gnosis Safe verification of an already existent multisig address.\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"create(address[],uint256,bytes)\":{\"notice\":\"This function operates with existent multisig proxy that is requested to be updated in terms of         the set of owners' addresses and the threshold. There are two scenarios possible:         1. The multisig proxy is already updated before reaching this function. Then the multisig address            must be passed as a payload such that its owners and threshold are verified against those specified            in the argument list.         2. The multisig proxy is not yet updated. Then the multisig address must be passed in a packed bytes of            data along with the Gnosis Safe `execTransaction()` function arguments packed payload. That payload            is going to modify the mulsisig proxy as per its signed transaction. At the end, the updated multisig            proxy is going to be verified with the provided set of owners' addresses and the threshold.         Note that owners' addresses in the multisig are stored in reverse order compared to how they were added:         https://etherscan.io/address/0xd9db270c1b5e3bd161e8c8503c55ceabee709552#code#F6#L56\"}},\"version\":1}},\"settings\":{\"compilationTarget\":{\"contracts/multisigs/GnosisSafeSameAddressMultisig.sol\":\"GnosisSafeSameAddressMultisig\"},\"evmVersion\":\"prague\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":750},\"remappings\":[\":@gnosis.pm/=node_modules/@gnosis.pm/\",\":ds-test/=lib/solmate/lib/ds-test/src/\",\":forge-std/=lib/forge-std/src/\",\":solmate/=lib/solmate/src/\"]},\"sources\":{\"contracts/multisigs/GnosisSafeSameAddressMultisig.sol\":{\"keccak256\":\"0xa6d655841ca1fb32d8bec1a067f57065901b693c1e170039bfffeda7adfeec79\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://2baf23434c813a00e5abee7309033f326057ee0154ab8cb4329b5d635a046a38\",\"d